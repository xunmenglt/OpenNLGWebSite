<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opennlg.mapper.TeamCultureMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.opennlg.pojo.TeamCulture">
        <id column="id" property="id" />
        <result column="image" property="image" />
        <result column="title" property="title" />
        <result column="outside_url" property="outsideUrl" />
        <result column="inside_url" property="insideUrl" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, image, title, outside_url, inside_url,create_time
    </sql>


    <select id="selectListByPage" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from og_team_culture
        order by create_time desc
    </select>
    
    

</mapper>
