# Docker / production deployment values. Copy to .env and replace every value.
OPENNLG_MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
OPENNLG_DB_URL=jdbc:mysql://mysql:3306/opennlg?serverTimezone=Asia/Shanghai&characterEncoding=utf8&useSSL=false
OPENNLG_DB_USERNAME=root
OPENNLG_DB_PASSWORD=replace-with-the-database-password
OPENNLG_JWT_SECRET=replace-with-a-long-random-secret
OPENNLG_FILE_PATH=/var/user/opennlgfiles/
OPENNLG_FILE_DOMAIN=https://example.org/api/files/
